# Einstellungen von MARLEI Tasks (wird nach /etc/marlei-tasks.env kopiert)
#
# Die Datei gehoert root. Die Anwendung liest sie beim Start und schreibt
# NIE hinein -- die Karte "Einstellungen" unter Einrichtung zeigt sie an
# und aendert nichts. Wer hier etwas aendert, startet den Dienst neu:
#
#     sudo systemctl restart marlei-tasks

# Unter welcher Adresse dieses Werkzeug erreichbar ist. Sie steht im
# Kopfband, damit man weiss, mit welchem Server man gerade redet.
# install.sh traegt hier die erkannte IP samt Port ein -- 8081, wenn
# nichts anderes gesagt wurde.
MARLEI_BASE_URL=http://192.168.178.31:8081

# Wo die Ablage liegt. EINE Datei, und sie ist das, was gesichert werden
# muss: Wer sie kopiert, hat alles.
#
# Ohne Angabe nimmt die Anwendung den Ort, der zum System passt: unter
# Linux diesen hier, unter Windows %ProgramData%\MARLEI Tasks. install.sh
# traegt ihn trotzdem ein -- was eingestellt ist, soll dastehen.
MARLEI_DB=/var/lib/marlei-tasks/tasks.db

# Wohin der Export schreibt -- fuenf Markdown-Dateien je Projekt.
#
# Bei unveraendertem Bestand ist die Ausgabe byteweise dieselbe. Das ist
# kein Selbstzweck: Zeigt dieser Pfad in ein Git-Repository, bekommt der
# Bestand damit eine Versionsgeschichte, ohne dass dieses Werkzeug etwas
# davon mitschreiben muesste.
#
# Leer heisst: kein Ausgang eingerichtet. Die Karte sagt das dann, statt
# irgendwohin zu schreiben.
MARLEI_EXPORT=/var/lib/marlei-tasks/ausgang

# Steht hier ein Wort, ist dieser Server nicht die Produktion: Der
# Seitengrund wechselt auf Sand, und das Wort steht in der Kopfzeile.
#
# **Die Farbe allein waere ein Code, den man kennen muss** -- deshalb das
# Wort. Auf dev-marlei gehoert hier "Entwicklung" hinein, wie beim
# Bootserver daneben.
MARLEI_KENNZEICHNUNG=

# Wohin ein Fehlerbericht geht. Der Server verschickt nichts -- er erzeugt
# den Text, der Betreiber liest ihn und schickt ihn selbst.
MARLEI_BERICHT=

# Pfad zu einer ufw-Konfiguration, falls sie nicht unter /etc/ufw liegt.
# Leer lassen, wenn nichts Besonderes eingerichtet ist.
MARLEI_UFW_CONF=

# Das Kennwort der Oberflaeche -- als Hash, nicht im Klartext.
#
# **Nicht von Hand eintragen.** Das Installationsskript fragt danach und
# schreibt den Hash selbst; neu setzen, wenn es vergessen ist:
#     sudo MARLEI_KENNWORT=neu ./setup/linux/install.sh
# Wiederherstellen laesst es sich nicht, nur neu setzen. Der Bestand
# bleibt dabei unberuehrt, und jede bestehende Anmeldung endet.
#
# Leer heisst: keine Anmeldung. Jeder, der die Oberflaeche im Netz
# erreicht, darf dann alles -- und das Band sagt es auf jeder Seite.
MARLEI_KENNWORT_HASH=
