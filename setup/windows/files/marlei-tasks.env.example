# Einstellungen von MARLEI Tasks unter Windows
# (wird nach %ProgramData%\MARLEI Tasks\marlei-tasks.env kopiert)
#
# Die Datei gehoert den Administratoren. Die Anwendung liest sie beim Start
# und schreibt NIE hinein -- die Karte "Einstellungen" unter Einrichtung
# zeigt sie an und aendert nichts. Wer hier etwas aendert, startet die
# Aufgabe neu:
#
#     Restart-ScheduledTask -TaskName "MARLEI Tasks"
#
# ZWEI VORLAGEN, EIN SATZ NAMEN. Daneben liegt setup/linux/files/ mit
# derselben Datei fuer Debian. Die Werte sind andere -- Pfade, die es auf
# dem anderen System nicht gibt --, **die Namen sind dieselben, und das
# ist kein Zufall, sondern geprueft:** Die Testreihe haelt beide Vorlagen
# gegen das, was der Code liest, und gegeneinander. Ein Wert, den nur eine
# Seite kennt, faellt damit auf, bevor er auf einer Maschine fehlt.
#
# Kein Anfuehrungszeichen um die Werte: Der Rest der Zeile gilt
# wortwoertlich, Leerzeichen in Pfaden eingeschlossen.

# Unter welcher Adresse dieses Werkzeug erreichbar ist. Sie steht im
# Kopfband, damit man weiss, mit welchem Server man gerade redet.
#
# **UND SIE IST HIER MEHR ALS EINE ANGABE:** Unter Windows steht kein
# nginx davor -- start.ps1 liest den Port aus genau dieser Adresse und
# uvicorn hoert darauf. Eine Zahl, eine Quelle. install.ps1 traegt die
# erkannte IP samt Port ein; 8081, wenn nichts anderes gesagt wurde.
MARLEI_BASE_URL=http://192.168.178.31:8081

# Wo die Ablage liegt. EINE Datei, und sie ist das, was gesichert werden
# muss: Wer sie kopiert, hat alles.
#
# Ohne Angabe nimmt die Anwendung den Ort, der zum System passt: unter
# Windows diesen hier, unter Linux /var/lib/marlei-tasks. install.ps1
# traegt ihn trotzdem ein -- was eingestellt ist, soll dastehen.
MARLEI_DB=C:\ProgramData\MARLEI Tasks\tasks.db

# Wohin der Export schreibt -- fuenf Markdown-Dateien je Projekt.
#
# Bei unveraendertem Bestand ist die Ausgabe byteweise dieselbe. Das ist
# kein Selbstzweck: Zeigt dieser Pfad in ein Git-Repository, bekommt der
# Bestand damit eine Versionsgeschichte, ohne dass dieses Werkzeug etwas
# davon mitschreiben muesste.
#
# Leer heisst: kein Ausgang eingerichtet. Die Karte sagt das dann, statt
# irgendwohin zu schreiben.
MARLEI_EXPORT=C:\ProgramData\MARLEI Tasks\ausgang

# Steht hier ein Wort, ist dieser Server nicht die Produktion: Der
# Seitengrund wechselt auf Sand, und das Wort steht in der Kopfzeile.
#
# **Die Farbe allein waere ein Code, den man kennen muss** -- deshalb das
# Wort. Auf einem Arbeitsplatz, auf dem entwickelt wird, gehoert hier
# "Entwicklung" hinein.
MARLEI_KENNZEICHNUNG=

# Wohin ein Fehlerbericht geht. Der Server verschickt nichts -- er erzeugt
# den Text, der Betreiber liest ihn und schickt ihn selbst.
MARLEI_BERICHT=

# NUR UNTER LINUX: Pfad zu einer ufw-Konfiguration, falls sie nicht unter
# /etc/ufw liegt.
#
# **Der Name steht hier trotzdem, und leer zu bleiben ist sein Sinn.**
# Unter Windows liest die Karte "Firewall" die Registry und nicht diese
# Datei; ein Wert hier aendert nichts. Weggelassen wuerde er aber beim
# naechsten Vergleich der beiden Vorlagen als Luecke auffallen -- und
# jemand traegt ihn dann in der Annahme nach, er fehle versehentlich.
MARLEI_UFW_CONF=

# Das Kennwort der Oberflaeche -- als Hash, nicht im Klartext.
#
# **Nicht von Hand eintragen.** Das Installationsskript fragt danach und
# schreibt den Hash selbst; neu setzen, wenn es vergessen ist:
#     .\setup\windows\install.ps1 -Kennwort   (als Administrator)
# Wiederherstellen laesst es sich nicht, nur neu setzen. Der Bestand
# bleibt dabei unberuehrt, und jede bestehende Anmeldung endet.
#
# Leer heisst: keine Anmeldung. Jeder, der die Oberflaeche im Netz
# erreicht, darf dann alles -- und das Band sagt es auf jeder Seite.
MARLEI_KENNWORT_HASH=

# --------------------------------------------------------------------------
# SELTEN GEBRAUCHT. Alles ab hier hat eine Vorgabe, die stimmt; die Namen
# stehen da, damit nichts im Code steckt, was man von aussen nicht finden
# kann. Wer nichts davon braucht, laesst den ganzen Block leer.
# --------------------------------------------------------------------------

# Wessen Stand die Versionssuche vergleicht. Nur fuer einen Fork
# interessant: Er soll sich mit sich selbst vergleichen und nicht mit dem
# Original.
#
# Ob ueberhaupt gesucht wird, steht NICHT hier, sondern in der Oberflaeche
# -- Reiter Einrichtung, Karte Stand. Dort liegt auch der Offline-Modus,
# der jede Abfrage nach draussen abstellt.
MARLEI_REPO=

# Wo die Einstellungen liegen, die die Oberflaeche selbst schreibt: wie
# oft nach neuen Versionen gesucht wird und ob der Offline-Modus an ist.
# Ohne Angabe: neben der Ablage, also unter %ProgramData%\MARLEI Tasks.
#
# Zwei Dateien und nicht eine, weil sie zu verschiedenen Zeiten gelesen
# werden. Diese hier wird beim Start gelesen; jene im Betrieb
# geschrieben, und was dort steht, wirkt ohne Neustart.
MARLEI_EINSTELLUNGEN=

# Wo der gemerkte Befund der Versionssuche liegt. Ohne Angabe: neben der
# Ablage. Die Datei ist wegwerfbar -- fehlt sie, wird beim naechsten Takt
# neu gefragt.
MARLEI_UPDATEWACHT_STAND=

# Wo der Stempel der Installation liegt (Stand, Commit, Zweig, Datum).
# Ohne Angabe: webui\VERSION, wohin ihn install.ps1 schreibt.
MARLEI_VERSION_DATEI=

# Welche Adresse die Versionssuche fragt. Fuer die Testreihe, damit sie
# nicht ins Netz muss.
MARLEI_VERGLEICH_ADRESSE=
